# config.env.example — 默认部署参数（远端 deploy.sh 会读取同名环境变量）
# 用法：cp config.env.example config.env，改完后在远端执行
#   set -a; . config.env; set +a; bash deploy.sh --yes

# 部署组合：all | vless | hy2 | socks5 | tune
PROFILE=all

# 代理核心：xray（默认，Reality 生态最全）| singbox（内存更省，客户端格式统一）
ENGINE=xray

# VLESS-Reality
VLESS_PORT=443
VLESS_SNI=www.cloudflare.com
# 伪装域名必须是目标机器能直连的 HTTPS 站点，且证书真实。常用：
#   www.cloudflare.com / itunes.apple.com / www.microsoft.com / dl.google.com
#   www.amazon.com / www.bing.com / connect.rom.miui.com
VLESS_UUID=
VLESS_SID=

# Hysteria2
HY2_PORT=10153
HY2_HOP=20000-40000
HY2_MODE=standalone
HY2_SNI=www.bing.com
HY2_AUTH=
HY2_OBFS=

# SOCKS5（danted，独立于核心，永远留一条后路）
SOCKS_PORT=1080
SOCKS_USER=node
SOCKS_PASS=

# 系统调优
DO_TUNE=1

# 443 被网站占用时用 nginx SNI 分流复用
NGINX_SPLIT=0

# GitHub 镜像（raw/codeload 被重置时填，逗号分隔，留空自动尝试）
MIRRORS=

# 指定核心版本（留空=latest，失败回退内置版本）
XRAY_VERSION=
SBOX_VERSION=
HY2_VERSION=
